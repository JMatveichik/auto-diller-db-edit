<UserControl x:Class="AutoLandProcessor.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:AutoLandProcessor.ViewModels"
			 xmlns:views="clr-namespace:AutoLandProcessor.Views"
			 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
			 mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>

		<DockPanel Grid.Row="0" Margin="10" Grid.ColumnSpan="2">

			<StackPanel Orientation="Horizontal"
						DockPanel.Dock="Left">

				<md:Badged Badge="{Binding Users.Count}" VerticalAlignment="Center">
					<md:PackIcon Kind="AccountMultiple"
							 HorizontalAlignment="Center"
							 VerticalAlignment="Center"
							 Width="32" Height="32" Margin="5"/>
				</md:Badged>

				<TextBlock Text="УПРАВЛЕНИЕ ПОЛЬЗОВАТЕЛЯМИ"
						   VerticalAlignment="Center"
						   Margin="10"
						   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>

				<TextBox
						Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}"
						 Width="200" Margin="20"
						  VerticalAlignment="Center"
						  md:HintAssist.Hint="Search users"
						  md:TextFieldAssist.HasClearButton="True"
						  Style="{StaticResource MaterialDesignFloatingHintTextBox}"
						  />

				<ComboBox
					  ItemsSource="{Binding AvailableRoles}"
					  SelectedItem="{Binding RoleFilter}"
					  MinWidth="100"
					  md:HintAssist.Hint="User role"
					  md:TextFieldAssist.HasClearButton="True"
					  Style="{StaticResource MaterialDesignFloatingHintComboBox}">
				</ComboBox>

			</StackPanel>
			<StackPanel  HorizontalAlignment="Right"
						 Orientation="Horizontal"
						 DockPanel.Dock="Right">

				<Button Style="{StaticResource MaterialDesignIconButton}"
						Margin="5"
						Command="{Binding Load}">
					<Button.Content>
						<md:PackIcon Kind="Reload" Width="24" Height="24"/>
					</Button.Content>
				</Button>

				<Button Style="{StaticResource MaterialDesignIconButton}"
					Margin="5"
					Command="{Binding AddUserCommand}">
					<Button.Content>
						<md:PackIcon Kind="AccountsAddOutline" Width="24" Height="24"/>
					</Button.Content>
				</Button>

			</StackPanel>
		</DockPanel>

		<!--
		<DataGrid Grid.Row="1"
				ItemsSource="{Binding Users}"
				AutoGenerateColumns="True">

		</DataGrid>-->

		<md:Card Grid.Row="1" Margin="2" md:ElevationAssist.Elevation="Dp4">
			<ListView Padding="5"
				ItemsSource="{Binding Users}"
				SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
				ScrollViewer.HorizontalScrollBarVisibility="Disabled">

				<ListView.Resources>

					<Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
						<Setter Property="VerticalAlignment" Value="Center"/>
					</Style>

					<Style TargetType="md:PackIcon">
						<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}"/>
						<Setter Property="VerticalAlignment" Value="Center"/>
						<Setter Property="Height" Value="16"/>
						<Setter Property="Width" Value="16"/>
						<Setter Property="Margin" Value="5,0,5,0"/>
					</Style>

					<Style x:Key="InfoStackPanel" TargetType="StackPanel">
						<Setter Property="Orientation" Value="Horizontal"/>
						<Setter Property="HorizontalAlignment" Value="Left"/>
						<Setter Property="Margin" Value="5, 2"/>
					</Style>

				</ListView.Resources>

				<ListView.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"  />
					</ItemsPanelTemplate>
				</ListView.ItemsPanel>

				<ListView.ItemTemplate>
					<DataTemplate>

						<md:Card   md:ElevationAssist.Elevation="Dp4"
							   Width="200" Height="130">

							<StackPanel Margin="5" Orientation="Vertical" >

								<Border BorderBrush="DarkGray" BorderThickness="0,0,0,1">
								<DockPanel Margin="5">

									<StackPanel DockPanel.Dock="Left" Style="{StaticResource InfoStackPanel}" VerticalAlignment="Center">
										<TextBlock Text="{Binding Name}"
										   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>

										<TextBlock Text="{Binding Surname}" Margin="5,0"
										   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
									</StackPanel>

									<StackPanel DockPanel.Dock="Left" Style="{StaticResource InfoStackPanel}" HorizontalAlignment="Right">

										<Button
											Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
											CommandParameter="{Binding}"
											Style="{StaticResource MaterialDesignIconButton}" Margin="0" Width="24" Height="24">
											<Button.Content>
												<md:PackIcon Kind="EditOutline" Width="16" Height="16"/>
											</Button.Content>
										</Button>

										<Button
											Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
											CommandParameter="{Binding}"
											Style="{StaticResource MaterialDesignIconButton}" Margin="0" Width="24" Height="24" VerticalAlignment="Center">
											<Button.Content>
												<md:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
											</Button.Content>
										</Button>
									</StackPanel>
								</DockPanel>
								</Border>

								<StackPanel Style="{StaticResource InfoStackPanel}">
									<md:PackIcon Kind="EmailOutline"/>
									<TextBlock Text="{Binding Email}" />
								</StackPanel>

								<StackPanel Style="{StaticResource InfoStackPanel}">
									<md:PackIcon Kind="Phone"/>
									<TextBlock Text="{Binding Telephone}"/>
								</StackPanel>

								<StackPanel Style="{StaticResource InfoStackPanel}">
									<md:PackIcon Kind="CakeVariantOutline"/>
									<TextBlock Text="{Binding Birthday, StringFormat='{}{0:dd MMMM yyyy}'}" />
								</StackPanel>

								<StackPanel Style="{StaticResource InfoStackPanel}">
									<md:PackIcon Kind="MapMarkerOutline"/>
									<TextBlock Text="{Binding Address}"/>
								</StackPanel>

							</StackPanel>

						</md:Card>

					</DataTemplate>
				</ListView.ItemTemplate>

			</ListView>
		</md:Card>
	</Grid>
</UserControl>
