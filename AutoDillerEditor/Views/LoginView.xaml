<UserControl x:Class="AutoLandProcessor.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoLandProcessor.Views"
			 xmlns:lc="clr-namespace:AutoLandProcessor.Controls"
			 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
			 mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
	</UserControl.Resources>



		<md:Card HorizontalAlignment="Center"
				 VerticalAlignment="Center"
				 MaxWidth="400"
				 UniformCornerRadius="5">

		<StackPanel Margin="20">
			<TextBlock Text="Введите данные для входа"
					   Margin="0,20"
					   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>

			<TextBlock Text="Имя пользователя"
						Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>

			<TextBox Text="{Binding Username}"  Margin="0,5,0,10"/>

			<TextBlock Text="Пароль"
					    Margin="0,0,0,5"
						Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />

			<lc:BindablePasswordBox
				Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

			<TextBlock Text="{Binding ErrorMessage}"
					    Margin="0,10"
						TextWrapping="Wrap"
						Style="{StaticResource MaterialDesignCaptionTextBlock}"
						Foreground="Red" />

			<ProgressBar IsIndeterminate="True"
						 Visibility="{Binding IsLoginInProcess,
												UpdateSourceTrigger=PropertyChanged,
												Converter='{StaticResource BoolToVisibilityConverter}'}"/>

			<Button Content="Войти" Command="{Binding LoginCommand}"
				HorizontalAlignment="Center" Margin="0,25"/>

		</StackPanel>
	</md:Card>

</UserControl>
