<UserControl x:Class="AutoLandProcessor.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoLandProcessor.Views"
			 xmlns:lc="clr-namespace:AutoLandProcessor.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
	</UserControl.Resources>

	<Border VerticalAlignment="Center"
				HorizontalAlignment="Center"
				CornerRadius="3"
				BorderThickness="1"
				BorderBrush="DarkGray">

		<StackPanel
				Margin="15">

			<TextBlock Text="Введите данные для входа" Margin="0, 0, 0, 15"  FontSize="15"></TextBlock>

			<TextBlock Text="Логин:" Margin="0,0,0,5"/>
			<TextBox Text="{Binding Username}" Margin="0,0,0,10"/>

			<TextBlock Text="Пароль:" Margin="0,0,0,5"/>
			<lc:BindablePasswordBox
			Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

			<TextBlock Text="{Binding ErrorMessage}"
						TextWrapping="Wrap" FontSize="10"
						Foreground="Red" Margin="0,10"/>

			<ProgressBar IsIndeterminate="True"
						 Visibility="{Binding IsLoginInProcess,
												UpdateSourceTrigger=PropertyChanged,
												Converter='{StaticResource BoolToVisibilityConverter}'}"/>

			<Button Content="Войти" Command="{Binding LoginCommand}"
				HorizontalAlignment="Center" Margin="20,5"/>
		</StackPanel>
	</Border>

</UserControl>
