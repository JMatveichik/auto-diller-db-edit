<Window x:Class="AutoLandProcessor.Views.EditUserDialog"
		x:ClassModifier="public"
		x:Name="userDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:AutoLandProcessor.Views"
		xmlns:vm="clr-namespace:AutoLandProcessor.ViewModels"
		xmlns:lc="clr-namespace:AutoLandProcessor.Controls"
		xmlns:valid="clr-namespace:AutoLandProcessor.Validation"
		xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
		xmlns:converters ="clr-namespace:AutoLandProcessor.Converters"
        mc:Ignorable="d"
        Title="EditUserDialog"
		WindowStartupLocation="CenterScreen"
		WindowStyle="None"
		Height="400" Width="500">

	<Window.Resources>
		<sys:Double x:Key="FieldWidth">150</sys:Double>
		<Thickness x:Key="IconMargin">0,0,8,0</Thickness>
		<converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />

		<Style x:Key="SettingsSection" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignSubtitle2TextBlock}">
			<Setter Property="Margin" Value="5, 10, 0, 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
			<Setter Property="Margin" Value="0,8" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
			<Setter Property="Margin" Value="0,8" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
			<Setter Property="Margin" Value="0,8" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}">
			<Setter Property="Margin" Value="0,8" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>


		<Style x:Key="FieldIcon" TargetType="md:PackIcon">
			<Setter Property="DockPanel.Dock" Value="Left" />
			<Setter Property="Margin" Value="{StaticResource IconMargin}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="FieldDockPanel" TargetType="DockPanel">
			<Setter Property="Margin" Value="0,0,8,16" />
			<Setter Property="VerticalAlignment" Value="Bottom" />
			<Setter Property="Width" Value="{StaticResource FieldWidth}" />
		</Style>
	</Window.Resources>

	<Grid>
		<md:Card md:ElevationAssist.Elevation="Dp4" >

			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Заголовок -->
				<TextBlock Grid.Row="0"
						   Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>

				<!-- Поля формы -->
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel>

						<TextBlock Text="Security" Style="{StaticResource SettingsSection}"/>
						<StackPanel Orientation="Horizontal">
							<!--User login-->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=LoginTextBox, Path=BorderBrush}"
									Kind="Account"
									Style="{StaticResource FieldIcon}" />

								<TextBox x:Name="LoginTextBox"
									md:HintAssist.Hint="User login">

									<TextBox.Text>
										<Binding Path="Login"
											 UpdateSourceTrigger="PropertyChanged">
											<Binding.ValidationRules>
												<valid:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>

							</DockPanel>

							<!-- User password -->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=PasswordBox, Path=BorderBrush}"
									 Kind="Key"
									 Style="{StaticResource FieldIcon}" />

								<!--
								<lc:BindablePasswordBox x:Name="PasswordBox"
														Password="{Binding Password}"
														md:HintAssist.HelperText="At least 8 characters"
														md:HintAssist.Hint="Password"
														md:TextFieldAssist.HasClearButton="True" />
								-->
								<TextBox x:Name="PasswordBox"
										 md:HintAssist.Hint="User password">

									<TextBox.Text>
										<Binding Path="Password"
										 UpdateSourceTrigger="PropertyChanged">
											<Binding.ValidationRules>
												<valid:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>

							</DockPanel>

							<!-- Роль -->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=RolesBox, Path=BorderBrush}"
									Kind="AccountQuestion"
									Style="{StaticResource FieldIcon}" />


								<ComboBox
									x:Name="RolesBox"
									ItemsSource="{Binding Source={x:Static vm:UsersViewModel.AvailableRoles}}"
									SelectedValue="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									MinWidth="115"
									md:HintAssist.HelperText="Select one user role"
									md:HintAssist.Hint="User role"
									md:TextFieldAssist.HasClearButton="True">
								</ComboBox>

							</DockPanel>

						</StackPanel>

						<TextBlock Text="Personal" Style="{StaticResource SettingsSection}"/>
						<StackPanel Orientation="Horizontal">
							<!--User name -->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=UserNameTextBox, Path=BorderBrush}"
									Kind="CommentAccountOutline"
									Style="{StaticResource FieldIcon}" />

								<TextBox x:Name="UserNameTextBox"
									md:HintAssist.Hint="User name">

									<TextBox.Text>
										<Binding Path="Name"
												 UpdateSourceTrigger="PropertyChanged">
											<Binding.ValidationRules>
												<valid:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>

							</DockPanel>


							<!--User surname -->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=UserSurnameTextBox, Path=BorderBrush}"
									Kind="CommentAccountOutline"
									Style="{StaticResource FieldIcon}" />

								<TextBox x:Name="UserSurnameTextBox"
									md:HintAssist.Hint="User surname">

									<TextBox.Text>
										<Binding Path="Surname"
										 UpdateSourceTrigger="PropertyChanged">
											<Binding.ValidationRules>
												<valid:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>

							</DockPanel>

							<!--User birthday -->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<DatePicker
							md:TextFieldAssist.HasClearButton="True"
							md:HintAssist.Hint="User birthday"
							SelectedDate="{Binding Birthday}"/>

							</DockPanel>

						</StackPanel>

						<TextBlock Text="Contacts" Style="{StaticResource SettingsSection}"/>
						<StackPanel Orientation="Horizontal">
							<!--User email-->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=EmailTextBox, Path=BorderBrush}"
						Kind="Email"
						Style="{StaticResource FieldIcon}" />

								<TextBox x:Name="EmailTextBox"
								md:HintAssist.Hint="User email">

									<TextBox.Text>
										<Binding Path="Email"
								 UpdateSourceTrigger="PropertyChanged">
											<Binding.ValidationRules>
												<valid:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>

							</DockPanel>

							<!--User phone-->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=PhoneTextBox, Path=BorderBrush}"
										Kind="Phone"
										Style="{StaticResource FieldIcon}" />

								<TextBox x:Name="PhoneTextBox"
								md:HintAssist.Hint="User phone">

									<TextBox.Text>
										<Binding Path="Telephone"
								 UpdateSourceTrigger="PropertyChanged">
											<Binding.ValidationRules>
												<valid:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>

							</DockPanel>


							<!--User address-->
							<DockPanel Style="{StaticResource FieldDockPanel}">

								<md:PackIcon Foreground="{Binding ElementName=AddressTextBox, Path=BorderBrush}"
							Kind="Location"
							Style="{StaticResource FieldIcon}" />

								<TextBox x:Name="AddressTextBox"
							md:HintAssist.Hint="User address">

									<TextBox.Text>
										<Binding Path="Address"
								UpdateSourceTrigger="PropertyChanged">
											<Binding.ValidationRules>
												<valid:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>

							</DockPanel>
						</StackPanel>

					</StackPanel>
				</ScrollViewer>

				<!-- Кнопки сохранения/отмены -->
				<StackPanel Grid.Row="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right">

					<Button Content="Save"
							Click="OnButtonSaveClick"
							Width="100" Margin="0,0,10,0"/>

					<Button Content="Cancel"
							Click="OnButtonCancelClick"
							Width="100"/>

				</StackPanel>

			</Grid>
		</md:Card>
	</Grid>

</Window>
