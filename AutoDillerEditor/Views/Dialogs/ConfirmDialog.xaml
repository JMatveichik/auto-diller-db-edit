<Window x:Class="AutoLandProcessor.Views.ConfirmDialog"
		x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoLandProcessor.Views"
        mc:Ignorable="d"
		Width="300" Height="200"
		WindowStyle="None"
		WindowStartupLocation="CenterScreen"
		Title="ConfirmDialog" d:Height="200" d:Width="400">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Border BorderBrush="DarkOrange" BorderThickness="0,0,0,1" Margin="5">
		<TextBlock Grid.Row="0" Margin="3"
					Text ="{Binding MessageTitle}"
					Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
		</Border>

		<TextBlock Grid.Row="1"  Margin="20, 10" TextAlignment="Justify"
				   Text="{Binding MessageBody}"
				   TextWrapping="Wrap"
				   Style="{StaticResource MaterialDesignBody2TextBlock}">
		</TextBlock>

		<!-- Кнопки сохранения/отмены -->
		<StackPanel Grid.Row="2" Margin="10"
							Orientation="Horizontal"
							HorizontalAlignment="Right">

			<Button Content="Yes"
							Click="OnButtonYesClick"
							Width="100" Margin="0,0,10,0"/>

			<Button Content="No"
							Click="OnButtonNoClick"
							Width="100"/>

		</StackPanel>

	</Grid>
</Window>
