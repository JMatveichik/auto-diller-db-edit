<Window x:Class="AutoLandProcessor.Views.LoginDialog"
		x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoLandProcessor.Views"
		xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        mc:Ignorable="d"
        Title="LoginDialog" Height="260" Width="350"
		WindowStartupLocation="CenterOwner">


	<Grid Margin="10">

		<StackPanel VerticalAlignment="Center" Margin="5">
			<TextBlock Text="Введите данные для входа" Margin="0, 0, 0, 15"  FontSize="15"></TextBlock>

			<TextBlock Text="Логин:" Margin="0,0,0,5"/>
			<TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

			<TextBlock Text="Пароль:" Margin="0,0,0,5"/>
			<PasswordBox x:Name="PasswordBox" Margin="0,0,0,0"/>

			<TextBlock Text="{Binding ErrorMessage}" FontSize="10"
					   Foreground="Red" Margin="0,10"/>

			<Button Content="Войти" Command="{Binding LoginCommand}"
					HorizontalAlignment="Center" Padding="20,5"/>
		</StackPanel>
	</Grid>
</Window>
