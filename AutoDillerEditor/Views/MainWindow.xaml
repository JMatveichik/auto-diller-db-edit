<mah:MetroWindow x:Class="AutoLandProcessor.Views.MainWindow"
		x:Name="Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:AutoLandProcessor"
		xmlns:views="clr-namespace:AutoLandProcessor.Views"
		xmlns:vm="clr-namespace:AutoLandProcessor.ViewModels"
		mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
		WindowStartupLocation="CenterScreen"
		WindowState="Maximized"
		Style="{StaticResource MaterialDesignWindow}">

	<ContentControl Content="{Binding CurrentView}"/>

</mah:MetroWindow>
