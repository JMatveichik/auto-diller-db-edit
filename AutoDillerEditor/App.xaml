<Application x:Class="AutoLandProcessor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoLandProcessor"
			 xmlns:md ="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:v ="clr-namespace:AutoLandProcessor.Views"
			 xmlns:vm ="clr-namespace:AutoLandProcessor.ViewModels">

    <Application.Resources>

		<ResourceDictionary>

			<DataTemplate DataType="{x:Type vm:LoginViewModel}">
				<v:LoginView/>
			</DataTemplate>

			<DataTemplate DataType="{x:Type vm:MainContentViewModel}">
				<v:MainContentView/>
			</DataTemplate>

			<ResourceDictionary.MergedDictionaries>
				<md:BundledTheme BaseTheme="Light" PrimaryColor="BlueGrey" SecondaryColor="Lime" />

				<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>

	</Application.Resources>
</Application>
